{
  "name": "astro-d1-reactions",
  "version": "0.0.0-development",
  "description": "Astro integration for page reactions backed by Cloudflare D1: unique reads, hearts, reader highlights and a public stats page",
  "keywords": [
    "analytics",
    "astro",
    "astro-component",
    "astro-integration",
    "cloudflare",
    "cloudflare-d1",
    "d1",
    "hearts",
    "highlights",
    "reactions",
    "stats"
  ],
  "homepage": "https://github.com/mrmartineau/astro-d1-reactions",
  "bugs": {
    "url": "https://github.com/mrmartineau/astro-d1-reactions/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Zander Martineau",
    "email": "zander@zander.wtf",
    "url": "https://zander.wtf"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmartineau/astro-d1-reactions.git"
  },
  "files": [
    "dist",
    "src/components",
    "src/icons",
    "src/core.ts",
    "src/env.d.ts",
    "migrations"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./components": "./src/components/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "vp check --fix",
    "dev": "tsdown --watch",
    "prepare": "vp config",
    "release": "semantic-release",
    "test": "bun test"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "astro": "^7.0.6",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
